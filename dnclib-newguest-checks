
#
# check variables and if guest lives already
# defines $ip
#

# provided as args
[[ -z $slot ]]  && bomb missing \$slot
[[ -z $guest ]] && bomb missing \$guest

# shorthands
[[ -z $short ]] && bomb missing \$short

# todo sync with current conf
# provided by dnc.conf
[[ -z storage ]]   && bomb missing \$storage
[[ -z data ]]      && bomb missing \$data
[[ -z pvh ]]       && bomb missing \$pvh
[[ -z kernelver ]] && bomb missing \$kernelver

# provided by dnclib-checks
[[ -z $res ]]   && bomb missing \$res

alive=`dsh -e -g xen "xl list | grep -E \"^$res[[:space:]]+\"" | cut -f1 -d:`
[[ -n $alive ]] && echo $res already lives on $alive && exit 1

# gw and friends got sourced by dnc.conf
# but guest ip gets eveluated by dec2ip function
dec2ip $slot

# use -n not -z as && wouldnt happen
[[ -n $ip ]] || bomb missing \$ip
[[ -n $gw ]] || bomb missing \$gw

